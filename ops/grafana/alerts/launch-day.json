{
  "folderUID": "monaco-business",
  "ruleGroup": "launch-day",
  "interval": "1m",
  "rules": [
    {
      "uid": "monaco-money-poller-stalled",
      "title": "A money poller has not completed a tick for 5 minutes",
      "condition": "C",
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "2m",
      "labels": {
        "team": "monaco",
        "severity": "critical"
      },
      "annotations": {
        "summary": "Deposits, withdrawals, cash-outs or swaps stop advancing while a money poller is stalled. Check the worker logs for poller.tick.failed with this poller."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "time() - poller_last_success_timestamp_seconds{money=\"true\"} > 300",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ]
    },
    {
      "uid": "monaco-events-stream-storage-70",
      "title": "JetStream account storage is above 70% of its limit",
      "condition": "C",
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "5m",
      "labels": {
        "team": "monaco",
        "severity": "critical"
      },
      "annotations": {
        "summary": "EVENTS uses DiscardNew: a full account fails every publish and the relay stalls. Lower MaxBytes or MaxAge, or purge EVENTS; Postgres events is the record."
      },
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "monaco_bus_account_storage_bytes / (monaco_bus_account_storage_limit_bytes > 0) > 0.7",
            "instant": true,
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "B",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                }
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            }
          }
        }
      ]
    },
