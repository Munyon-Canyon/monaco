# Build-time config for the fund page. Vite inlines these into the bundle, so none is secret.
# Local run against `just run`: see "Fund page against a local backend" in README.md.

# The local backend. The fund page's CSP allows only this API origin.
VITE_MONACO_API_URL=http://localhost:8080
# PRIVY_APP_ID from `just show-env`. The same app id the iOS app uses.
VITE_PRIVY_APP_ID=
# sandbox in dev and on preview deploys, production on the production branch.
VITE_PRIVY_ENV=sandbox
