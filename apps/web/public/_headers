# Cloudflare Pages equivalent of vercel.json's "headers". Keep the two in sync while
# both hosts are live. Every matching rule is applied, so /assets/* gets the security
# headers below as well as its own Cache-Control.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=86400

# The fund page. Its full Content-Security-Policy is a meta tag written at build time (see
# csp.ts), because the API origin differs per deploy; this header adds frame-ancestors, which a
# meta tag cannot set. The page carries a one-time token, so nothing caches it.
/fund
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

/fund/*
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
