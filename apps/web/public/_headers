# Cloudflare Pages equivalent of vercel.json's "headers". Keep the two in sync while
# both hosts are live. Every matching rule is applied, so /assets/* gets the security
# headers below as well as its own Cache-Control.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=86400

# iOS fetches this file with no extension and needs it served as JSON (Universal Links for /r/*).
/.well-known/apple-app-site-association
  Content-Type: application/json

# The fund page. Its full Content-Security-Policy is a meta tag written at build time (see
# csp.ts), because the API origin differs per deploy; this header adds frame-ancestors, which a
# meta tag cannot set. The page carries a one-time token, so nothing caches it. The /* rule's camera=()
# also switches the camera off in every nested frame, so /fund drops it and lets the providers'
# KYC frames ask for the camera. Keep this list equal to vercel.json's and to the providers in csp.ts.
/fund
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://*.stripe.com" "https://*.moonpay.com" "https://pay.coinbase.com" "https://*.meld.io" "https://meldcrypto.com"), microphone=(), geolocation=()
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'

/fund/*
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://*.stripe.com" "https://*.moonpay.com" "https://pay.coinbase.com" "https://*.meld.io" "https://meldcrypto.com"), microphone=(), geolocation=()
  Cache-Control: no-store
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
