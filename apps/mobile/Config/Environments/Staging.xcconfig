// Staging: the API host comes from MONACO_STAGING_API_BASE_URL (the Render staging service,
// https://monaco-api-tw4p.onrender.com). Set it in .env.local (scripts/ensure-ios-privy-config.sh
// writes it to the gitignored Config/Environment.local.xcconfig) or pass it to xcodebuild.
// Must be https. Left empty, the app refuses to launch with this environment selected.
MONACO_STAGING_API_BASE_URL =
MONACO_API_BASE_URL_staging = $(MONACO_STAGING_API_BASE_URL)
// From .env.staging, the staging Privy app the staging backend verifies tokens for.
// Left empty, the app refuses to launch with this environment selected.
PRIVY_APP_ID_staging = $(PRIVY_APP_ID_STAGING)
PRIVY_APP_CLIENT_ID_staging = $(PRIVY_APP_CLIENT_ID_STAGING)
