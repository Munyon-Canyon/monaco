// Base configuration for the Monaco app target (Debug and Release).
// Privy credentials + the API environment. Values reach the app through Info.plist
// (Config/Privy.local.Info.plist, generated by scripts/ensure-ios-privy-config.sh) and
// are read in one place: MonacoCore's MonacoConfig.api.
#include "Privy.xcconfig"

#include "Environments/Local.xcconfig"
#include "Environments/Staging.xcconfig"
#include "Environments/Production.xcconfig"

// Debug talks to the backend on this Mac; Release (archive / TestFlight) is production.
// Pick another one per build:  xcodebuild ... MONACO_ENVIRONMENT=staging
MONACO_ENVIRONMENT_DEFAULT_Debug = local
MONACO_ENVIRONMENT_DEFAULT_Release = production
MONACO_ENVIRONMENT = $(MONACO_ENVIRONMENT_DEFAULT_$(CONFIGURATION))

MONACO_API_BASE_URL = $(MONACO_API_BASE_URL_$(MONACO_ENVIRONMENT))
PRIVY_APP_ID = $(PRIVY_APP_ID_$(MONACO_ENVIRONMENT))
PRIVY_APP_CLIENT_ID = $(PRIVY_APP_CLIENT_ID_$(MONACO_ENVIRONMENT))

// Push entitlement stays `development` in the file; archive export re-signs it as
// production. The Info.plist key uses Apple's sandbox/production names.
MONACO_APS_ENVIRONMENT_Debug = sandbox
MONACO_APS_ENVIRONMENT_Release = production
MONACO_APS_ENVIRONMENT = $(MONACO_APS_ENVIRONMENT_$(CONFIGURATION))

// Connect X is hidden in every build until X's API access is sorted (#4581). Turn it on per
// build with  xcodebuild ... MONACO_FEATURE_CONNECT_X=YES  or per launch with -MonacoFeatureConnectX YES.
MONACO_FEATURE_CONNECT_X = NO

INFOPLIST_KEY_NSContactsUsageDescription = Find friends who are already on Monaco. Monaco hashes your contacts' phone numbers on your phone and sends only the hashes. Names and your address book stay on your phone.

CODE_SIGN_ENTITLEMENTS = Monaco/Monaco.entitlements

// Gitignored, written by scripts/ensure-ios-privy-config.sh from .env.local:
// MONACO_STAGING_API_BASE_URL / MONACO_PRODUCTION_API_BASE_URL. Included last so it
// wins over the placeholders above.
#include? "Environment.local.xcconfig"
