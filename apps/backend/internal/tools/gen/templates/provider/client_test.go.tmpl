func TestClient_readsAThingFromTheFixture(t *testing.T) {
	t.Parallel()
	srv := httptest.NewServer(fakes.New())
	t.Cleanup(srv.Close)
	c := {{.Name}}.New(httpclient.New(
		"{{.Name}}", httpclient.WithBaseURL(srv.URL+"/{{.Name}}"), httpclient.WithTimeout(10*time.Second),
	))
	got, err := c.Thing(t.Context(), "t1")
	if err != nil {
		t.Fatal(err)
	}
	if got != ({{.Name}}.Thing{ID: "t1"}) {
		t.Fatalf("Thing = %+v, want t1", got)
	}
	step, err := json.Marshal(fakes.Step{
		Route: "/{{.Name}}/things/t1", Action: fakes.ActionFail, Status: http.StatusNotFound,
	})
	if err != nil {
		t.Fatal(err)
	}
	req, err := http.NewRequestWithContext(t.Context(), http.MethodPost, srv.URL+"/_script", bytes.NewReader(step))
	if err != nil {
		t.Fatal(err)
	}
	resp, err := srv.Client().Do(req)
	if err != nil {
		t.Fatal(err)
	}
	_ = resp.Body.Close()
	if _, err := c.Thing(t.Context(), "t1"); errs.CodeOf(err) != errs.CodeNotFound {
		t.Fatalf("Thing after a scripted 404 err = %v, want not_found", err)
	}
}

func TestFake_failsWhereFaultsSay(t *testing.T) {
	t.Parallel()
	f := &{{.Name}}fake.Fake{Things: map[string]{{.Name}}.Thing{"t1": {ID: "t1"}}}
	f.FailOnce("Thing", errs.New(errs.CodeUpstreamTimeout, "test"))
	if _, err := f.Thing(t.Context(), "t1"); errs.CodeOf(err) != errs.CodeUpstreamTimeout {
		t.Fatalf("first Thing err = %v, want the scripted fault", err)
	}
	if got, err := f.Thing(t.Context(), "t1"); err != nil || got.ID != "t1" {
		t.Fatalf("second Thing = %+v, %v", got, err)
	}
}
