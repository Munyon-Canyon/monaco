# Local development only. Copy to `.env` and adjust if needed.
# Never put production Supabase URLs or secrets in this repo.

# Docker Compose Postgres (default host port 54322 avoids local Postgres on 5432)
POSTGRES_USER=monaco
POSTGRES_PASSWORD=monaco
POSTGRES_DB=monaco
POSTGRES_PORT=54322

# Optional: this machine's slim iOS Simulator UUID (not a secret; `simctl create` mints a new one).
# Used by just build/reset mobile and scripts/stop-mobile.sh. Also export in the shell for ios-sim.
# SIMSLIM_UDID=

# Backend boot config, read once by apps/backend/internal/platform/config.
# Required: MONACO_ENV, DATABASE_URL, NATS_URL, MONACO_DEV_TOKEN_KEY (outside production). Commented keys show their default.
# An unknown MONACO_* key fails boot, so a typo cannot fall back to a default.
# environment: local, test, staging or production
MONACO_ENV=local
# database (secret). Must point at localhost compose, not cloud Supabase.
DATABASE_URL=postgres://monaco:monaco@localhost:54322/monaco?sslmode=disable
TEST_DATABASE_URL=postgres://monaco:monaco@localhost:54323/monaco?sslmode=disable
# pool
# MONACO_DB_MAX_CONNS=10
# bus (secret)
NATS_URL=nats://localhost:4222
# listen
# MONACO_HTTP_ADDR=:8080
# request body cap in bytes
# MONACO_HTTP_MAX_BODY_BYTES=1048576
# health
# MONACO_WORKER_HEALTH_ADDR=:8081
# dev auth (secret). Signs HS256 dev tokens from monacoctl dev token; staging and production refuse this placeholder at boot, and production never accepts dev tokens.
MONACO_DEV_TOKEN_KEY=change-me-dev-only
# telemetry. Unset sends no OTLP.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# auth (secret)
# OTEL_EXPORTER_OTLP_HEADERS=
# service
# OTEL_SERVICE_NAME=monaco
# Outbound deadlines and server timeouts, as Go durations.
# rpc
# MONACO_TIMEOUT_RPC=5s
# privy
# MONACO_TIMEOUT_PRIVY=10s
# apns
# MONACO_TIMEOUT_APNS=10s
# quote
# MONACO_TIMEOUT_JUPITER_QUOTE=5s
# execute
# MONACO_TIMEOUT_JUPITER_EXECUTE=2m
# posthog
# MONACO_TIMEOUT_POSTHOG=3s
# read
# MONACO_TIMEOUT_HTTP_SERVER_READ=10s
# write
# MONACO_TIMEOUT_HTTP_SERVER_WRITE=30s
# shutdown
# MONACO_TIMEOUT_SHUTDOWN=10s

# Privy and Solana, read by platform/config into chain/privy, chain/solana and chain/relayer.
# Backend uses app id + secret (secret); iOS uses app id + client id.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# The app's verification key (PEM public key, ES256) from the Privy dashboard. Every access
# token is verified against it. Keep the PEM newlines, or write it on one line with literal \n.
# In staging and production, the api refuses to boot when it holds the fixture key that
# `monacoctl dev privy-token --print-public-key` prints.
PRIVY_VERIFICATION_KEY=
# Server-side wallet signing (secret). Private key from Privy dashboard > Authorization keys.
# PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:...
# Quorum id for the same key: the additional signer on new member wallets and owner of app wallets.
# PRIVY_AUTHORIZATION_KEY_ID=
# Svix signing secret for Privy webhooks (secret).
# PRIVY_WEBHOOK_SECRET=whsec_...
# Optional base URL override (tests point it at cmd/fakes).
# PRIVY_BASE_URL=https://api.privy.io
# Solana JSON-RPC endpoint (secret: paid endpoints carry a key in the URL). The public default is
# rate limited with no SLA: fine for local dev, set a paid RPC for staging and production.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Solana fee payer for every transfer (secret). Base58 64-byte secret key, NOT a JSON [1,2,...] array.
# In staging and production, api and worker refuse to boot when it holds 0.001 SOL or less.
# RELAYER_PRIVATE_KEY=
# iOS app client id from Privy dashboard > App Settings > Clients (bundle: com.monaco.app)
PRIVY_APP_CLIENT_ID=
# Legacy alias some local .env.local files use instead of PRIVY_APP_CLIENT_ID (mobile accepts either)
# PRIVY_AUTH_ID=

# Mobile login method flags (default on). Email uses Privy OTP, not password fields (M1-T11 UI).
PRIVY_SMS_LOGIN_ENABLED=true
PRIVY_EMAIL_LOGIN_ENABLED=true

# PostHog project API key. Empty is valid; #638 puts the real value in .env.local.
# scripts/ensure-ios-privy-config.sh writes it into the generated Info.plist.
POSTHOG_API_KEY=

# iOS API environments (not secrets). Debug builds use http://localhost:8080 and need neither.
# PLACEHOLDERS: no staging/production host exists in this repo — set the real https:// URL
# before building for that environment (README "iOS API environments").
# scripts/ensure-ios-privy-config.sh writes them to apps/mobile/Config/Environment.local.xcconfig.
# MONACO_STAGING_API_BASE_URL=
# MONACO_PRODUCTION_API_BASE_URL=

# App Store Connect API key for scripts/ios-release.sh (secret). Role: App Manager.
# ASC_KEY_P8_BASE64 is the .p8 file, base64-encoded. All three stay empty until that key exists.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_P8_BASE64=

# Supabase Storage (dev project monaco-dev). Backend upload only — mobile calls Go API, not Supabase.
# Dashboard: https://supabase.com/dashboard/project/komoccjaeypsrgocrnht
# SUPABASE_URL=https://<dev-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# MONACO_TIMEOUT_STORAGE=10s

# Pyth Hermes (M4+ marked pot, asset charts). Create a key at https://pyth.network/price-feeds/pyth-core
# PYTH_API_KEY=
# Optional override; default is the post-upgrade host https://pyth.dourolabs.app/hermes
# PYTH_HERMES_BASE_URL=
# Equity xStock marks (AAPLx, etc.) need equity feed grants on the key in Pyth Terminal.
# A valid key that only covers crypto returns 403 "Not entitled" for equity price updates.
#
# Pyth Benchmarks serves a whole chart range as OHLC in one call and needs no key, so
# charts keep working on a crypto-only key — and with PYTH_API_KEY unset entirely.
# Without a key you lose marked-pot valuation, the stock-vs-token card and the
# per-sample chart fallback; the charts themselves still draw. Optional override;
# default is the public host.
# PYTH_BENCHMARKS_BASE_URL=https://benchmarks.pyth.network

# Jupiter Swap API v2 and Price API v3. The key goes in the x-api-key header on every call;
# without one the API serves requests at a lower rate limit. Get a key at https://portal.jup.ag
# JUPITER_API_KEY=
# Optional base URL overrides (tests point these at cmd/fakes).
# MONACO_JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
# MONACO_JUPITER_PRICE_BASE_URL=https://api.jup.ag/price/v3
# How often the worker samples every catalog mint from Jupiter Price v3 into price_points.
# MARKET_PRICE_POLL_INTERVAL=120s

# APNs push notifications, token auth. One .p8 key covers sandbox and production and every app on the team
# (docs/architecture/notifications.md#one-time-apple-setup). The three keys are required in staging and
# production, and whenever APNS_KEY_P8 is set. With no key in local or test, the worker sends nothing and logs
# apns.noop_send.
# The .p8 contents (secret), with real newlines or literal \n on one line.
# APNS_KEY_P8=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.monaco.app
# Optional: send both environments to a plain HTTP/1.1 server such as cmd/fakes. Refused in production.
# APNS_BASE_URL=http://127.0.0.1:8099/apns

# PostHog project API key (secret). The worker's analytics consumer sends money and social events with it.
# Production refuses to boot without one; elsewhere an empty key turns the export off.
# POSTHOG_API_KEY=
# US region host. Tests point it at cmd/fakes.
# POSTHOG_HOST=https://us.i.posthog.com

# Tessera pre-IPO catalog (public API, no key). Default base is https://rest-api.tessera.pe.
# TESSERA_API_BASE_URL=https://rest-api.tessera.pe
# TESSERA_ENABLED=true
# PRESTOCKS_API_BASE_URL=https://prestocks.com
# PRESTOCKS_ENABLED=true

# Platform (all optional).
# LOG_FILE: append every log line as JSON to this path (stderr keeps a JSON copy). Unset =
# stderr only, which the host must capture (journald, docker; `just run` tees it to .logs/).
# Rotate with logrotate copytruncate.
# LOG_FILE=/var/log/monaco/api.log
# CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call the API. Unset = none
# (the iOS app sends no Origin header and is unaffected). "*" is never honored.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# TRUST_PROXY_HEADERS=true keys per-IP rate limits on the rightmost X-Forwarded-For entry
# instead of the socket address. Set it only behind a proxy that appends that entry (Render).
# TRUST_PROXY_HEADERS=
# PUBLIC_API_BASE_URL: the API's public URL, used in agent connect instructions and
# /v1/agent/skill.md. Not a secret. Default http://127.0.0.1:8080; set the public https URL when deployed.
# PUBLIC_API_BASE_URL=http://127.0.0.1:8080
# SENTRY_DSN: error reporting for handler and poller panics and for alerts. Unset = off.
# Use a separate Sentry project (DSN) per environment.
# SENTRY_DSN=
# APP_ENV / RELEASE: environment name (dev, staging, prod) and build id (git sha) on Sentry events.
# APP_ENV also picks the stderr log format: text when unset, dev or local; JSON lines otherwise.
# APP_ENV=dev
# RELEASE=
# LOG_FORMAT: text or json, to override what APP_ENV picks.
# LOG_FORMAT=json
# ALERT_WEBHOOK_URL: Slack- or Discord-compatible incoming webhook that receives alerts (wedged
# cash out, poller panic, relayer low on SOL, Jupiter price source down). Unset = log + Sentry only.
# Point it at a channel someone watches.
# ALERT_WEBHOOK_URL=
# METRICS_TOKEN: bearer token a Prometheus scraper presents to GET /metrics. Unset = /metrics
# answers direct loopback callers only (a request with X-Forwarded-For is refused, so a
# reverse proxy on the same host cannot expose it).
# METRICS_TOKEN=

# Treasury swap venue: jupiter (default) or flash (Definitive Flash, https://flash.definitive.fi/docs).
# Flash needs an integrator key: app.definitive.fi > More > Flash > Create Flash Key.
# The first Flash trade of a token also lands a one-time relayer-paid setup tx (token account + SPL delegation).
# SWAP_PROVIDER=jupiter
# FLASH_API_KEY=
# Slippage bound for Flash market orders as a decimal (default 0.01 = 1%, max 0.05).
# FLASH_MAX_SLIPPAGE=0.01

# Manual (Privy dashboard): Login Methods > enable SMS and Email before testing auth.
# Email auth sends a one-time passcode to the inbox; enable both methods for M1 test accounts.

# Demo data (#153): enable POST /v1/dev/faker (loopback + local DB only). Off by default (404).
# FAKER_ENABLED=1
# FAKER_PHOTO_BASE_URL: where seeded users' avatar files are served from (README "Demo data").
# Unset = seeded users show initials.
# FAKER_PHOTO_BASE_URL=

# Where a stock's curve comes from: yahoo (the underlying equity, free, default for now) or jupiter (the xStock's own candles).
CHART_SOURCE=yahoo

# Fake money for walkthroughs: real sign-in and wallets, balances and fills in memory, nothing on Solana. Off unless 1.
DEMO_MODE=0
