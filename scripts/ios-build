#!/usr/bin/env bash
# Monaco iOS compile with Privy xcconfig on this checkout's simulator (the lane's own in a
# worktree, else SimSlim gold when ready, else stock). Builds into this checkout's
# .build/DerivedData (the cache monacoctl agents check uses) under an xcode build slot.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

./scripts/ensure-ios-privy-config.sh generate
udid="$(./scripts/resolve-ios-sim.sh)"

# Ad-hoc sign the sim build (see docs/how-to/local-simulator.md#signing): an unsigned
# build (CODE_SIGNING_ALLOWED=NO) can't hold a keychain-access-group entitlement, so the
# Privy session is silently dropped on every relaunch or reinstall. Automatic signing needs
# the team's own certificate, which not every contributor's machine has; "-" self-signs
# locally without one. -skipPackagePluginValidation runs MonacoAPI's OpenAPI generator
# without the one-time "Trust & Enable" click Xcode asks for per machine.
./scripts/qa/xcode-lock.sh xcode xcodebuild -project apps/mobile/Monaco.xcodeproj -scheme Monaco \
  -destination "platform=iOS Simulator,id=${udid}" \
  -configuration Debug \
  -derivedDataPath "$(git rev-parse --show-toplevel)/.build/DerivedData" \
  -skipPackagePluginValidation \
  CODE_SIGN_IDENTITY="-" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=YES \
  build
