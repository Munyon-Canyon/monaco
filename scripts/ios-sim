#!/usr/bin/env bash
# Monaco iOS sim launch with Privy env from dotenvx .env.local.
# In a linked worktree it builds, installs and launches on the lane's own simulator, so
# several worktrees run at once. In the primary checkout it prefers SimSlim gold when
# SIMSLIM_UDID exists and simslim is ready, else warns and boots a stock simulator.
# Does not require ~/.local/bin/ios-sim.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ "${MONACO_PRIVY_ENV:-}" != "1" ]]; then
  exec "$repo_root/scripts/with-ios-privy-env.sh" "$0" "$@"
fi

# shellcheck disable=SC1091 # sourced path is dynamic
source "$repo_root/scripts/run-with-logs.sh"

bundle_id="com.monaco.app"
monaco_step "mobile: picking a simulator"
udid="$(./scripts/resolve-ios-sim.sh)"
sim_name="$(xcrun simctl list devices | sed -n "s/^ *\(.*\) (${udid}).*/\1/p" | head -1)"

if command -v simslim >/dev/null 2>&1 && [[ -n "${SIMSLIM_UDID:-}" && "$udid" == "$SIMSLIM_UDID" ]]; then
  profile="${SIMSLIM_PROFILE:-}"
  if [[ -z "$profile" && -f "${HOME}/.config/simslim/base-slim.json" ]]; then
    profile="${HOME}/.config/simslim/base-slim.json"
  fi
  if [[ -n "$profile" ]]; then
    simslim verify "$udid" --profile "$profile" >/dev/null 2>&1 \
      || simslim on "$udid" --profile "$profile" >/dev/null 2>&1 \
      || echo "warning: simslim on failed. continuing with a stock boot." >&2
  fi
fi

open -a Simulator >/dev/null 2>&1 || true

_ios_clipboard_bridge() {
  local cmd="$1"
  if command -v ios-sim-clipboard-bridge >/dev/null 2>&1; then
    ios-sim-clipboard-bridge "$cmd" >/dev/null 2>&1 || true
  elif [[ -x "${HOME}/.local/bin/ios-sim-clipboard-bridge" ]]; then
    "${HOME}/.local/bin/ios-sim-clipboard-bridge" "$cmd" >/dev/null 2>&1 || true
  fi
}
_ios_clipboard_bridge start

# Ad-hoc sign the sim build (see docs/how-to/local-simulator.md#signing) so the Privy
# session's keychain entry survives relaunch/reinstall instead of being dropped by an
# unsigned build. -skipPackagePluginValidation: see scripts/ios-build. The derived data
# path is this checkout's own, so the app installed below is never another worktree's.
derived="$(git rev-parse --show-toplevel)/.build/DerivedData"
# xcodebuild prints thousands of lines; they go to a file so the step lines stay readable.
log_dir="${MONACO_LOG_DIR:-$repo_root/.logs}"
mkdir -p "$log_dir"
build_log="$log_dir/xcodebuild.log"
monaco_step "mobile: building the iOS app for ${sim_name:-$udid} (log: $build_log)"
rc=0
cache_args=()
while IFS= read -r a; do cache_args+=("$a"); done < <(./scripts/xcode-cache-args.sh)
# shellcheck disable=SC2016 # $1 and $@ expand in the inner bash
./scripts/qa/xcode-lock.sh xcode bash -c 'log=$1; shift; exec "$@" > "$log" 2>&1' _ "$build_log" \
  xcodebuild -project apps/mobile/Monaco.xcodeproj -scheme Monaco \
  -destination "platform=iOS Simulator,id=${udid}" \
  -configuration Debug \
  -derivedDataPath "$derived" \
  -skipPackagePluginValidation \
  "${cache_args[@]}" \
  CODE_SIGN_IDENTITY="-" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=YES \
  build || rc=$?
if (( rc != 0 )); then
  grep -E '(^|: )(fatal )?error: |\*\* BUILD FAILED \*\*' "$build_log" | awk '!seen[$0]++' | tail -40 >&2 || true
  monaco_step "mobile: build failed (exit $rc); full log: $build_log" >&2
  exit "$rc"
fi

app_path="${derived}/Build/Products/Debug-iphonesimulator/Monaco.app"
if [[ ! -d "$app_path" ]]; then
  echo "error: built app not found at ${app_path}" >&2
  exit 1
fi

monaco_step "mobile: booting ${sim_name:-$udid}"
xcrun simctl boot "$udid" >/dev/null 2>&1 || true
xcrun simctl bootstatus "$udid" -b >/dev/null
monaco_step "mobile: installing and launching ${bundle_id}"
xcrun simctl install "$udid" "$app_path"
xcrun simctl launch "$udid" "$bundle_id" >/dev/null
monaco_step "mobile: ready on ${sim_name:-simulator} (${udid})"
